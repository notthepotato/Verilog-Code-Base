# Question 1
f1:
    jalr zero, 0(ra)

# Question 2
# Define Params x,y,z with example numbers i guess

f2: # fuction preforms x + y – z
    add a0, a0, a1 # a0 = sum of x and y
    sub a0, a0, a2 # a0 = (x+y) - z
jalr zero, 0(ra)

# Question 3

f3: # fuction preforms x * y + z
    addi sp, sp, -16 # Reserve space in the stack

    sw s5, 0(sp) # Return variable

    add t0, a0, a1 # t0 = x + y
    sub s5, t0, a2 # s5 = (x+y) - z

    add a0, zero, s5 # Load s5 into a0 to return

    lw s5, 0(sp) # restore s5 into da stack

    addi sp, sp, 16 # Dealocate space in the stack

jalr zero, 0(ra)

# Question 4 

f4: 
    addi sp, sp, -16     # Reserve space in the stack

    sw ra, 4(sp)         # Save return address
    sw s2, 0(sp)         # Save original s2 into the stack

    add t0, zero, a0     # t0 = x
    add a0, zero, a1     # a0 = y
    add a1, zero, t0     # a1 = x

    jal ra, f9           # Call function f9 result lands in a0

    add s2, zero, a0     # Put val in s2
    add a0, zero, s2     # Load s2 into a0 to return

    lw s2, 0(sp)         # restore s2 into the stack
    lw ra, 4(sp)         # restore ra into the stack

    addi sp, sp, 16      # Dealocate space in the stack

jalr zero, 0(ra)

# Question 5

# A the function returns 7

# B)
dologic:
    addi sp, sp, -32     # Reserve space in the stack

    sw ra, 16(sp)        # Save return address
    sw s2, 12(sp)        # Save original s2
    sw a0, 8(sp)         # Save a
    sw a2, 4(sp)         # Save c 
    sw a3, 0(sp)         # Save d 

    # x = and(a, b)
    jal ra, and          # Result lands in a0
    add s2, zero, a0     # s2 = x = and(a, b)

    # x = x | xor(c, d)
    lw a0, 4(sp)         # Restore original c
    lw a1, 0(sp)         # Restore original d
    jal ra, xor          # Result in a0
    or s2, s2, a0        # s2 = x | xor(c, d)

    # x = x | a
    lw t0, 8(sp)         # Restore original a into t0
    or s2, s2, t0        # s2 = x | a

    # Prepare return value
    add a0, zero, s2     # Load s2 into a0 to return

    lw ra, 16(sp)        # Restore ra from the stack
    lw s2, 12(sp)        # Restore s2 from the stack
    addi sp, sp, 32      # Deallocate space in the stack

jalr zero, 0(ra)

and:
    and a0, a0, a1
jalr zero, 0(ra)

xor:
    xor a0, a0, a1
jalr zero, 0(ra)